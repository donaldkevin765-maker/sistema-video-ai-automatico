# Dimensioni output (default 1000x1000)
VIDEO_WIDTH=1000
VIDEO_HEIGHT=1000
VIDEO_DURATION=5

# Provider chain (ordine di tentativo)
# Valori: runway, luma, local
VIDEO_PROVIDERS=runway,luma,local

# API Keys (almeno una necessaria per generare)
RUNWAY_API_KEY=
LUMA_API_KEY=

# Endpoint locale (opzionale, per CogVideoX / SVD)
LOCAL_ENDPOINT=http://localhost:8000
LOCAL_MODEL=cogvideox-5b

# Strict mode: true = prompt usato VERBATIM, nessuna modifica
STRICT_MODE=true

# Directory output
OUTPUT_DIR=./output
