# === FREE PROVIDERS ===

# 1. Locale (diffusers + PyTorch MPS su Mac Apple Silicon)
# Funziona senza API key, usa GPU Mac
# Richiede: pip install diffusers torch transformers accelerate
LOCAL_MODEL=cogvideox-5b

# 2. Hugging Face Inference API (free tier)
# Registrati: https://huggingface.co/join
# Token: https://huggingface.co/settings/tokens (leggero, gratis)
HF_API_TOKEN=
HF_MODEL=THUDM/CogVideoX-5B

# 3. Replicate (free credits $5 nuovi utenti)
# Registrati: https://replicate.com
REPLICATE_API_TOKEN=
REPLICATE_MODEL=lucataco/cogvideox-5b:9221c1a7c9e7c2e0e2e8b7e3b6e2c0

# === OUTPUT ===
VIDEO_WIDTH=1000
VIDEO_HEIGHT=1000
VIDEO_DURATION=5
STRICT_MODE=true

# Provider chain (ordine di tentativo): local, huggingface, replicate
VIDEO_PROVIDERS=local,huggingface,replicate
